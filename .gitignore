# Dependencies
node_modules/

# Environment — JANGAN commit kredensial
.env
.env.local
.env.*.local

# Database runtime (file SQLite di-generate saat seed, bukan source)
*.db
*.sqlite
*.sqlite3
# WAL/SHM: journal_mode=WAL bikin dua file pendamping di samping .db
*.db-wal
*.db-shm

# Backup DB — `*.db` TIDAK mencakup .db.gz, jadi harus disebut sendiri.
# Berisi data pengguna (email, password hash); jangan pernah masuk repo.
backups/

# Tapi tetap track SQL source files di database/
!database/schema.sql
!database/seed_management.sql

# Logs
logs/
*.log
npm-debug.log*

# CodeGraph index
.codegraph/

# OS artifacts
.DS_Store
Thumbs.db

# Editor
.vscode/settings.json
*.swp
*.swo
tmp/
