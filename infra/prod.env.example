# Template only: placeholders, never real values. Never commit the real file.
# Real file lives OUTSIDE git, e.g. /opt/edulib/prod.env:
#   sudo install -m 600 -o root -g root infra/prod.env.example /opt/edulib/prod.env
# Generate secrets: openssl rand -hex 32   (DB passwords)   openssl rand -hex 48   (JWT)
# Use hex/alphanumeric values: no quotes, spaces, `$` or `#` (Compose env-file parsing).

# --- PostgreSQL (private, never published) ---
# Superuser: backups/maintenance only. App never uses it.
POSTGRES_ADMIN_USER=edulib_admin
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_ADMIN_DB_PASSWORD
# App role + DB, created on first volume init by infra/postgres/init-app-role.sh.
# Must NOT end with _staging (staging has its own stack and guards).
APP_DB_NAME=edulib
APP_DB_USER=edulib_app
APP_DB_PASSWORD=REPLACE_WITH_APP_DB_PASSWORD

# --- Auth ---
# Changing this logs out every user (all JWTs invalid). Keep the same value across VPS moves.
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET

# --- CORS: frontend on Azure Static Web Apps ---
FRONTEND_URL=https://edulib.id,https://www.edulib.id

# --- Email (Resend) ---
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
MAIL_FROM=Ucup Edu Lib <no-reply@edulib.id>
PASSWORD_RESET_BASE_URL=https://edulib.id

# --- Media (Cloudflare R2) ---
R2_ACCOUNT_ID=REPLACE_WITH_R2_ACCOUNT_ID
R2_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=REPLACE_WITH_R2_BUCKET_NAME
# Public bucket base URL, no trailing slash.
R2_PUBLIC_URL=https://REPLACE_WITH_R2_PUBLIC_HOST

# --- TLS / ACME (host paths, outside git) ---
# TLS_DIR must hold real files fullchain.pem + privkey.pem (see runbook: certbot deploy hook).
TLS_DIR=/opt/edulib/tls
ACME_WEBROOT=/opt/edulib/acme

# --- Image + ports ---
# Pin a verified release, e.g. edulib-api:<git-sha> (built locally or pulled).
EDULIB_API_IMAGE=edulib-api:REPLACE_WITH_RELEASE_SHA
EDULIB_BIND=0.0.0.0
EDULIB_HTTP_PORT=80
EDULIB_HTTPS_PORT=443
