# ucup-edu-lib :: contoh environment backend
# Salin ke .env lalu isi nilainya. JANGAN commit .env.
#   cp .env.example .env

# --- Server ---
PORT=3000
# Bind address. Default 127.0.0.1 (loopback) supaya Node hanya bisa dihubungi
# lewat Nginx — WAJIB tetap loopback di VPS, karena app.set('trust proxy', 1)
# mempercayai header X-Forwarded-For dari satu hop di depannya.
HOST=127.0.0.1

# --- Auth ---
# WAJIB diisi. Tidak ada fallback di kode: kalau kosong, login gagal dengan 500
# (disengaja — fallback hardcoded berarti siapa pun bisa memalsukan token).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- CORS ---
# Daftar origin frontend, dipisah koma. Tanpa spasi setelah koma juga boleh.
FRONTEND_URL=https://edulib.id,https://www.edulib.id

# --- Database ---
# sqlite3 (default) atau pg
DB_CLIENT=sqlite3
# Path relatif di-resolve ke root project, bukan cwd.
DB_FILENAME=./database/ucup-edu-lib.db
# Hanya dipakai kalau DB_CLIENT=pg
# DB_HOST=localhost
# DB_PORT=5432
# DB_DATABASE=ucup_edu_lib
# DB_USER=
# DB_PASSWORD=

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Base URL publik bucket, TANPA slash di akhir.
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev
